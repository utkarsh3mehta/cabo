# Copy to .env next to compose.yaml and adjust. Never commit .env.

# Public DNS name pointing at this server (A/AAAA record). Caddy requests a
# Let's Encrypt certificate for it automatically.
DOMAIN=cabo.example.com

# The exact origin players use in their browser. Must match DOMAIN (https).
# Used for the WebSocket origin check, CSP and invitation links.
PUBLIC_ORIGIN=https://cabo.example.com

# Contact address for the Let's Encrypt account (certificate expiry notices). Required.
ACME_EMAIL=you@example.com

# Optional host port overrides (defaults 80 / 443).
# HTTP_PORT=80
# HTTPS_PORT=443

# Optional tuning (milliseconds unless noted).
# LOG_LEVEL=info
# RECONNECT_GRACE_MS=60000        # seat reserved after a disconnect before host/bot actions
# ROOM_IDLE_TTL_MS=900000         # room removed after 15 min without connected humans
# FINISHED_ROOM_TTL_MS=1800000    # finished room removed after 30 min
# MAX_ROOMS=1000                  # concurrent rooms (count)

# There are no other secrets: guest tokens are generated at runtime and kept in memory.
